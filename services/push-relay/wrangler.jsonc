{
  // The push relay (docs/plans/push-relay.md). The ids below are the deployed ones; the secrets
  // (APNS_KEY_P8, APNS_KEY_ID, APNS_TEAM_ID) are set with `wrangler secret put`, see README.md.
  "name": "rustling-tulip-push-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "rt-push.leftos.dev", "custom_domain": true }],
  "workers_dev": false,
  "kv_namespaces": [
    // Owner-written deny list: `sender:{sha256 hex of the raw k= point}` and `token:{sha256 hex of the token}`.
    { "binding": "DENY_LIST", "id": "5c09036b53cd4b248a91946aedae70be" },
    // Daily per-token counters and the cached APNs provider token (`apns-jwt`).
    { "binding": "RELAY_STATE", "id": "097cafda8b3f4dee87272f508137ccef" }
  ],
  // Each namespace_id is an integer unique within the account.
  "ratelimits": [
    { "name": "TOKEN_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "SENDER_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "IP_LIMITER", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } }
  ],
  "vars": {
    // The relay's own origin, the VAPID JWT `aud` it accepts.
    "RELAY_ORIGIN": "https://rt-push.leftos.dev",
    // "true" serves; anything else is the kill switch (503).
    "RELAY_ENABLED": "true",
    // The app's bundle ID, the APNs topic.
    "APNS_TOPIC": "dev.leftos.rustling-tulip.phone"
  }
}
