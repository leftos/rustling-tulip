{
  "name": "@rustling-tulip/e2e",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "End-to-end test harness + interactive driving for the rustling-tulip Tauri app, via tauri-driver and WebdriverIO.",
  "scripts": {
    "doctor": "tsx scripts/doctor.ts",
    "host": "tsx src/host.ts",
    "host:build": "tsx src/host.ts --build",
    "test": "mocha",
    "test:wdio": "wdio run wdio.conf.ts",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "rt-e2e": "src/cli.ts"
  },
  "dependencies": {
    "@wdio/cli": "9.27.1",
    "@wdio/globals": "9.27.1",
    "@wdio/local-runner": "9.27.1",
    "@wdio/mocha-framework": "9.27.1",
    "@wdio/spec-reporter": "9.27.1",
    "chai": "6.2.2",
    "mocha": "11.7.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "webdriverio": "9.27.1",
    "ws": "8.20.0"
  },
  "devDependencies": {
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "22.19.18",
    "@types/ws": "8.18.1"
  }
}
