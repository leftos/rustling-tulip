{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rustling-tulip",
  "version": "0.1.0",
  "identifier": "dev.leftos.rustling-tulip",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "rustling-tulip",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Multi-repo Claude Code wrapper",
    "longDescription": "Tauri desktop app + Rust daemon that orchestrates parallel Claude Code sessions across single repos and multi-repo workspaces."
  }
}
